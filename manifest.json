{
  "manifest_version": 3,
  "name": "Presenter View Shortcut (F4)",
  "version": "2.3.1",
  "description": "Press F4 in Canva or Google Slides to open Presenter view and throw the slides fullscreen onto your other monitor. By: Jojo5",
  "permissions": ["tabs", "system.display", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.canva.com/*", "*://docs.google.com/presentation/*"],
      "js": ["settings.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
